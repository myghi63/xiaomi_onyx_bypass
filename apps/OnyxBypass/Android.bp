package {
    // See here for license info.
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "OnyxBypass",
    certificate: "platform",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],
}
